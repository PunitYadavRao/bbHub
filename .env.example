# Copy to .env.local for local development. Never commit real values.

# Postgres connection string for local development.
# On Netlify, NETLIFY_DB_URL is provided automatically and used instead.
DATABASE_URL="postgresql://user:pass@host/bbhub?sslmode=require"

# Better Auth: generate with `openssl rand -hex 32`
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google sign-in (optional; the button is hidden when these are empty)
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email login codes (optional locally: codes are printed to the terminal instead)
RESEND_API_KEY=""
EMAIL_FROM="BBHub <verify@bbhub.app>"
