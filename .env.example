# Copy to .env.local for local development. Never commit real values.

# Neon Postgres: use the *pooled* connection string
DATABASE_URL="postgresql://neondb_owner:xxxx@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Better Auth: generate with `openssl rand -hex 32`
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (Web application). Redirect URIs to register in Google Cloud:
#   http://localhost:3000/api/auth/callback/google
#   https://bbhub.app/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
